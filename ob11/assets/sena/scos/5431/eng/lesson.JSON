 0}]}]}], "stimuli": [{"_data": [], "type": "welcome", "contents": [{}], "id": 0, "template_override": 1}, {"id": 1, "contents": [{"value": {"audiosrc": "engenn4le12ob11re2aud01", "images": [{"image": "engenn4le12ob11re2img05.jpg", "id": 0, "text": "", "time": "0"}, {"image": "engenn4le12ob11re2img05.jpg", "id": 1, "text": "<span class = \"strong\">John</span>:  Hi! <br/>\n<span class = \"strong\">Vanessa</span>: Hi, John! How's your life on the cruise ship?<br/>\n<span class = \"strong\">John</span>: It's great. I was in Mexico in time to see the Day of the Dead festivities.  <br/>\n<span class = \"strong\">Vanessa</span>: What happens?", "time": "20"}, {"image": "engenn4le12ob11re2img01.jpg", "id": 2, "text": "<span class = \"strong\">John</span>: People play music or tell stories to honor the deceased. They have picnics in cemeteries and eat a special kind of bread. <br/>\n<span class = \"strong\">Vanessa</span>:  Neat!  I could go next year.<br/>\n<span class = \"strong\">John</span>: Are you going to go home for Thanksgiving? <br/>\n<span class = \"strong\">Vanessa</span>: Yes, I should be able to go. <br/>\n<span class = \"strong\">John</span>: How is cooking school going?", "time": "9000"}, {"image": "engenn4le12ob11re2img02.jpg", "id": 3, "text": "<span class = \"strong\">Vanessa</span>: I'm working hard, but I'm learning a lot.  Next weekend is Fiesta on the Hill.  People can taste different foods and listen to live music on the streets. We're going to organize a community barbecue. I have to buy some ingredients this afternoon.<br/>\n<span class = \"strong\">John</span>:  Sounds tasty!", "time": "25000"}], "coverimg": "engenn4le12ob11re2img05.jpg"}, "type": "slideshow"}], "template_override": 1, "_data": [], "type": "audio", "title": ""}], "id": 0, "type": "scholar", "_data": [{"type": "lab_options", "contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}]}]}]}