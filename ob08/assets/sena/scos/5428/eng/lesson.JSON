"id": 0, "correct": 1}], "_data": [{"type": "question", "contents": [{"type": "pdf", "content": "engenn4le12ob08re7pdf01.pdf"}]}], "id": 0}], "type": "DWS", "id": 11, "_data": [{"type": "instructions", "contents": [{"type": "text", "content": " It's time for you to write your opinion on a festival or tradition."}]}, {"type": "group", "contents": [{"type": "group_name", "content": "Take Away"}]}, {"type": "feedback", "content": {"correct_feedback": "Correct!", "attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}], "allowed_attempts": 2}}, {"type": "learning_skills", "contents": [{"type": "skill", "content": "Reading"}, {"type": "skill", "content": "Writing"}, {"type": "skill", "content": "Speaking"}]}, {"type": "post_instructions", "contents": [{"type": "text", "content": "Instructions: Complete the following steps. Fill in the Self-Assessment. "}]}]}], "stimuli": [{"type": "welcome", "id": 0, "_data": [], "contents": [{}], "template_override": 1}, {"title": "", "id": 3, "template_override": 1, "type": "audio", "_data": [], "contents": [{"type": "slideshow", "value": {"audiosrc": "engenn4le12ob08re2aud01", "coverimg": "engenn4le12ob08re2img01.jpg", "images": [{"text": "", "id": 0, "image": "engenn4le12ob08re2img05.jpg", "time": "0"}, {"text": "The Day of the Dead festival was an interesting cultural experience. I thought it would be a sad day but I was wrong. Mexican families remembered their loved ones by telling stories and having picnics in cemeteries.", "id": 1, "image": "engenn4le12ob08re2img05.jpg", "time": "0020"}, {"text": "Family members cleaned the graves of the dead and left trinkets or candles. I believe it was a wonderful insight into the lives of others. You could hear the soft sound of music while people shared meals with family members and neighbors.", "id": 2, "image": "engenn4le12ob08re2img02.jpg", "time": "13500"}, {"text": "Some families took part in craft activities and musical performances. Traditional music played in the streets. People prayed in churches and in their homes. They also shared photos of the deceased and talked to them. It was a touching tribute to their loved ones.", "id": 3, "image": "engenn4le12ob08re2img01.jpg", "time": "29000"}]}}]}, {"title": "", "id": 4, "template_override": 1, "type": "video", "_data": [], "contents": [{"type": "video", "value": {"video_src": "engenn4le12ob08re3vid01", "images": [{"text": "", "id": 0, "image": "", "time": "0"}, {"text": "<span class = \"bullet\">A short travel journal</span>", "id": 1, "image": "", "time": "5000"}, {"text": "<span class = \"bullet\">What does John include in his journal about the Day of the Dead?</span>", "id": 2, "image": "", "time": "17000"}, {"text": "<span class = \"bullet\">What do travel journals include?</span>", "id": 3, "image": "", "time": "89000"}]}}]}], "type": "scholar", "id": 0, "_data": [{"type": "lab_options", "contents": [{"type": "has_nav", "content": true}, {"type": "has_exercise_controls", "content": true}]}]}], "type": "sena", "_data": [{"type": "metadata", "contents": [{"type": "lesson_name", "content": "John in Mexico"}, {"type": "unit_name", "content": "A Land of Traditions"}, {"type": "position", "content": 8}, {"type": "origin", "content": "scholar > Taking a Break > Baja"}, {"type": "lesson", "content": 12}, {"type": "level", "content": "A2.1"}]}, {"type": "achievment_test", "contents": [{"type": "test", "content": "false"}]}, {"type": "objectives", "contents": [{"type": "primary", "content": "Accurately use information about travel and vacations in social situations."}, {"type": "secondary_1", "content": "Identifies general information in short written or spoken conversations about advice for a healthy lifestyle."}, {"type": "secondary_2", "content": "Identifies general information in short written or spoken conversations about advice for a healthy lifestyle."}, {"type": "secondary_3", "content": "Identifies general information in short written or spoken conversations about advice for a healthy lifestyle."}, {"type": "secondary_4", "content": "Identifies general information in short written or spoken conversations about advice for a healthy lifestyle."}, {"type": "secondary_5", "content": "Identifies general information in short written or spoken conversations about advice for a healthy lifestyle."}, {"type": "secondary_6", "content": "Identifies general information in short written or spoken conversations about advice for a healthy lifestyle."}, {"type": "secondary_7", "content": "Identifies general information in short written or spoken conversations about advice for a healthy lifestyle."}, {"type": "secondary_8", "content": "Identifies general information in short written or spoken conversations about advice for a healthy lifestyle."}]}, {"type": "background_image", "content": "engenn4le12ob08re1img01.jpg"}, {"type": "learning_points", "contents": [{"type": "heading", "content": "The Simple Past Tense"}, {"type": "describer", "content": "When you talk about events in the past, you usually use the Simple Past tense."}, {"type": "text", "content": "1. You use the Simple Past tense to talk about an action that happened <span class = \"strong\">at a specific time in the past</span>.<br/><br/><amples:<br><span class = \"italic\">Sally left for France on June 11th.</span><br/><span class = \"italic\">Peter visited his parents on Saturday.</span><br/><br/>2. You use the Simple Past tense to talk about <span class = \"strong\">repeated</span> actions in the past.<br/><br/>Examples:<br><span class = \"italic\">We went hiking every day in Grand Canyon.</span><br/><span class = \"italic\">Vanessa always went to the mall on Saturdays.</span><br/><br/>3. You use the Simple Past tense to talk about something that was <span class = \"strong\">true for some length of time</span> in the past.<br/><br/>Examples:<br><span class = \"italic\">John hated going to high school</span>.<br/><span class = \"italic\">Sally played the violin when she was in school.</span><br/><br/>You often use phrases with <span class = \"strong\">ago</span> with the Simple Past tense.<br/><br/>Example:<br><span class = \"italic\">Sally and Vanessa met a long time ago.</span><span class=\"strong\">"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "deceased"}, {"type": "definition", "content": "a dead person or dead people"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: People celebrate the deceased in some  cultures."}, {"type": "audio", "content": "engenn4le12ob08aud01"}]}, {"type": "target_word_describer", "contents": [{"type": "text", "content": "These are words you use when you write about a tradition."}]}, {"type": "target_word", "contents": [{"type": "name", "content": "tribute"}, {"type": "definition", "content": "something that you say, give, or do to show respect or affection for someone"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: It was a wonderful tribute to their grandfather."}, {"type": "audio", "content": "engenn4le12ob08aud06"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "touching "}, {"type": "definition", "content": "having a strong emotional effect "}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: It was touching to see the family come together."}, {"type": "audio", "content": "engenn4le12ob08aud05"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "loved one "}, {"type": "definition", "content": "a person who is loved, usually a family member"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: We honor our loved ones."}, {"type": "audio", "content": "engenn4le12ob08aud03"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "insight "}, {"type": "definition", "content": "the ability to understand situations and people clearly"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: The tradition gave me insight into their culture."}, {"type": "audio", "content": "engenn4le12ob08aud02"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "performance"}, {"type": "definition", "content": "an activity such as singing a song or acting in a play"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: The musical performance was excellent."}, {"type": "audio", "content": "engenn4le12ob08aud04"}]}, {"type": "takeaway_extension", "contents": [{"type": "text", "content": "Research an interesting festival or tradition."}, {"type": "text", "content": "Write a paragraph of 50 words."}, {"type": "text", "content": "Include a topic sentence, supporting sentences and a concluding sentence."}, {"type": "text", "content": " Provide your opinion."}, {"type": "text", "content": "Read your paragraph aloud to a partner."}]}, {"type": "takeaway_assessment", "contents": [{"type": "text", "content": "I identify an interesting festival or tradition."}, {"type": "text", "content": "I write a paragraph on a festival or tradition."}, {"type": "text", "content": "I include my opinion on a festival or tradition."}, {"type": "text", "content": "I read my paragraph to a partner."}]}]}