[{"_data": [], "template_override": 1, "type": "welcome", "contents": [{}], "id": 0}, {"id": 1, "type": "audio", "title": "", "_data": [], "template_override": 1, "contents": [{"type": "slideshow", "value": {"audiosrc": "st_324_2_sl", "coverimg": "5338_exe.jpg", "images": [{"text": "Baja California is a beautiful peninsula. It lies between the Pacific Ocean and the Sea of Cortez and is one thousand miles long.", "id": 0, "time": "0", "image": "5338_exe.jpg"}, {"text": "People can get there by land, sea or air. In Baja they find deserts, mountains and islands. They also find whales, all kinds of tropical fish and other sea life.", "id": 1, "time": "9301", "image": "st_324_2_sl02.jpg"}, {"text": "Diving is very popular in Baja. Both new and experienced divers enjoy diving there.", "id": 2, "time": "22101", "image": "st_324_2_sl03.jpg"}]}}]}, {"id": 2, "type": "audio", "title": "", "_data": [], "template_override": 1, "contents": [{"type": "slideshow", "value": {"audiosrc": "engenn4le12ob04re2aud01", "coverimg": "engenn4le12ob04re2img05.jpg", "images": [{"text": "", "id": 0, "time": "0", "image": "engenn4le12ob04re2img05.jpg"}, {"text": "<span class  = \"strong\">John</span>: Excuse me, are you taking the windsurfing day tour today?</br>\n<span class  = \"strong\">Tourist</span>: Yes, actually. How did you know?</br>", "id": 1, "time": "0090", "image": "engenn4le12ob04re2img05.jpg"}, {"text": "<span class  = \"strong\">John</span>: I heard you and your wife talking at breakfast this morning.</br>\n<span class  = \"strong\">Tourist</span>: Yes, we are looking forward to windsurfing in Baja.</br>", "id": 2, "time": "5500", "image": "engenn4le12ob04re2img01.jpg"}, {"text": "<span class  = \"strong\">John</span>: The weather looks miserable. There are whitecaps on the water.  It's so windy today!</br>\n<span class  = \"strong\">Tourist</span>: I agree. The weather is pretty wild. We are feeling a little nervous!</br>", "id": 3, "time": "12000", "image": "engenn4le12ob04re2img03.jpg"}, {"text": "<span class  = \"strong\">John</span>: Don't worry. Windsurfing in Baja is a wonderful experience.</br>\n<span class  = \"strong\">Tourist</span>: Hmmm. We shall see.</br>", "id": 4, "time": "22250", "image": "engenn4le12ob04re2img02.jpg"}, {"text": "<span class  = \"strong\">John</span>: Are you renting the equipment on the cruiseship or on the beach?</br>\n<span class  = \"strong\">Tourist</span>: On the beach. What time is the bus picking up passengers?</br>\n<span class  = \"strong\">John</span>: 8 a.m. sharp, I am planning to join the group today.</br>\n<span class  = \"strong\">Tourist</span>: That's great!</br>", "id": 5, "time": "28500", "image": "engenn4le12ob04re2img01.jpg"}]}}]}], "_data": [{"type": "lab_options", "contents": [{"type": "has_nav", "content": true}, {"type": "has_exercise_controls", "content": true}]}], "id": 0, "type": "scholar", "exercises": [{"questions": [], "stimuli_ids": [0], "id": 0, "type": "WLC", "img_path": "", "_data": [{"type": "instructions", "contents": [{"type": "skill", "content": "Reading"}, {"type": "skill", "content": "Listening"}, {"type": "skill", "content": "Vocabulary and Grammar"}, {"type": "Learning Outcomes", "content": "I can say and use words that start with W. "}, {"type": "Learning Outcomes", "content": "I can talk about what people are doing and not doing."}, {"type": "Learning Outcomes", "content": " I can identify key information in a short audio."}, {"type": "Free Header Item", "content": "How often do you go to the beach?"}, {"type": "Free Header Item", "content": "Do you prefer swimming in a pool or in the ocean? Why?"}]}, {"type": "group", "contents": [{"type": "group_name", "content": "Welcome"}]}, {"type": "feedback", "content": {"allowed_attempts": 2, "correct_feedback": "Correct", "attempt_feedback": [{"type": "text", "content": "You have 2 tries"}, {"type": "text", "content": "you have 1 attempt left"}], "incorrect_feedback": [{"type": "text", "content": "try again"}, {"type":